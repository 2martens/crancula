<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Mac App Store build: App Sandbox. Crancula reads and writes files only through open and save
  dialogs (ADR 4, 21, 28) and keeps its snapshots in userData, which lives in the sandbox container.
  TEAM_ID is replaced with the Apple Team ID before packaging (release workflow, job "App Store").
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.application-groups</key>
    <array>
      <string>TEAM_ID.de.twomartens.crancula</string>
    </array>
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
  </dict>
</plist>
